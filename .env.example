# Copie ce fichier en « .env » pour changer la configuration (facultatif : les valeurs ci-dessous sont les défauts).
# Aucun secret n'est nécessaire : le Veilleur de Nuit n'appelle aucune API externe.

# Port d'écoute du serveur
PORT=3000

# Adresse d'écoute (127.0.0.1 = uniquement cette machine ; 0.0.0.0 = tout le réseau)
HOST=127.0.0.1

# Fichier de la base SQLite (créé automatiquement, dossier compris)
DB_PATH=./data/noctambouffe.db
